# Скопируйте в .env и подставьте свои значения; .env в .gitignore, не коммитится.

# Сервер для web/deploy/deploy.sh: пользователь и адрес для ssh.
# Если репозиторий склонирован на сам сервер и скрипт запускается там — UF_DEPLOY_HOST=local
UF_DEPLOY_HOST=root@<IP сервера>

# Домен сайта (необязательно). Пусто — nginx отвечает по IP на любой Host
UF_DOMAIN=
